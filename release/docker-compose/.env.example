# Image to pull from your container registry. For a local build use cdc-lite-server:local.
CDC_LITE_IMAGE=ghcr.io/pranavb1234/cdc-lite:latest
CDC_LITE_PORT=3000

# Generate once and preserve forever: 32 random bytes, standard Base64 encoded.
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Used only on the first startup to create the local administrator account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters
